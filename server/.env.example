# Demo environment variables for ORDIX server
# Copy this file to .env and update values for your local environment.

# =====================
# Server Configuration
# =====================
PORT=5000
NODE_ENV=development

# =====================
# Database
# =====================
# PostgreSQL connection string
# Example format: postgres://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL=postgres://user:password@localhost:5432/ordix_dev

# =====================
# JWT Configuration
# =====================
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production
JWT_EXPIRES_IN=7d

# =====================
# Google OAuth
# =====================
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
GOOGLE_CALLBACK_URL=http://localhost:5000/api/v1/auth/google/callback

# =====================
# Frontend Configuration
# =====================
FRONTEND_URL=http://localhost:5173
FRONTEND_CALLBACK_URL=http://localhost:5173/auth/google/callback

# =====================
# Email Configuration (for password reset)
# =====================
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your_email@gmail.com
EMAIL_PASSWORD=your_app_password_here
EMAIL_FROM=noreply@ordix.com

# =====================
# Super Admin Seeder
# =====================
SUPER_ADMIN_EMAIL=superadmin@example.com
SUPER_ADMIN_PASSWORD=superadminpassword
SUPER_ADMIN_FIRST_NAME=Super
SUPER_ADMIN_LAST_NAME=Admin
SUPER_ADMIN_PHONE=0000000000
